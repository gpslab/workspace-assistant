# Copy to .env and fill in. .env is in .gitignore, so tokens never reach the repository.
# Real environment variables (export) override the values from this file.
# Lists are comma-separated.

# Bot token from @BotFather (required)
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Whitelist of Telegram user ids (required; your own id: @userinfobot)
ALLOWED_USER_IDS=123456789

# Absolute path to the git repository (workspace) the bot manages (required)
REPO_PATH=/path/to/your/repo

# Forge the managed repositories live on: github | gitlab. Any other value is a startup error.
# With gitlab, epics are not available yet (/epic says so). Default: github
# FORGE=github

# Forge host. Default: github.com for FORGE=github, gitlab.com for FORGE=gitlab
# FORGE_HOST=github.com

# Repository of the workspace as owner/name, used for commit links.
# GITHUB_REPO is a deprecated alias; when both are set FORGE_REPO wins and a warning is logged.
# Default: empty
# FORGE_REPO=owner/repo

# Owners (users/orgs, with FORGE=gitlab namespace paths like group/subgroup) whose repositories
# the bot works with, comma-separated.
# The first one is the default owner: the short task form `repo#N` means `<first>/repo#N`.
# Epic tasks are `owner/repo#N` or `repo#N`; releases[].repo is `owner/repo` or `repo`.
# Required for epics and for PR links in the manual `review` mode. Default: empty
# GITHUB_OWNERS is a deprecated alias; when both are set FORGE_OWNERS wins and a warning is logged.
# FORGE_OWNERS=owner

# GitHub logins allowed to author the `<!-- openronin:bot -->` marker, comma-separated,
# case-insensitive. When unset, the marker is accepted from any author and the bot logs
# a warning at startup. Default: empty
# OPENRONIN_LOGINS=your-bot-login

# Exclusive repository executors, comma-separated owner/repository:openronin or
# owner/repository:coder assignments. A repository may occur only once; unlisted repositories
# are not coder-routed. The coder allowlist is exactly the repositories mapped to coder.
# Empty (the default) disables standalone issue intake. This does not reconfigure Openronin.
# REPOSITORY_EXECUTORS=owner/repo:coder,owner/other:openronin

# Trusted human GitHub login whose labeled event for openronin:do-it authorizes standalone
# intake. An issue edited after that event requires a fresh label.
# Required when a repository is mapped to coder. Separate from ALLOWED_USER_IDS and
# OPENRONIN_LOGINS. Polling is read-only and never starts a worker.
# CODER_INTAKE_AUTHOR=your-github-login

# Bounded intake polling: seconds between passes, seconds per pass, maximum repository scans
# and issue records per pass, and timeout of each GitHub request (no greater than the tick budget).
# Defaults: 30, 10, 4, 5.
# CODER_INTAKE_POLL_SECONDS=30
# CODER_INTAKE_TICK_BUDGET=10
# CODER_INTAKE_WORK_BUDGET=4
# CODER_INTAKE_REQUEST_TIMEOUT=5

# Agent engine that runs the jobs: claude | opencode | kimi. Any other value is a startup error.
# On opencode the instance starts the OpenCode CLI instead of Claude Code: the model comes from
# OPENCODE_MODEL (`/model` is read-only), every mode and the epics work with the gate carried by the
# gate plugin, and every run is approved automatically.
# On kimi the instance starts the Kimi Code CLI: the model comes from KIMI_MODEL (`/model` is
# read-only), chat and /compact work, the gated modes (pm, review) and the epics are refused for now,
# and every run is approved automatically under the permission rules of your Kimi configuration.
# Changing this needs a bot restart.
# Default: claude
# ENGINE=claude

# Path or name of the claude binary. Default: claude
CLAUDE_BIN=claude

# Overall limit for one Claude call, seconds. 0 disables it (the stall timeout
# below remains the safety net against a "forever" process). Default: 0
CLAUDE_TIMEOUT=0

# Activity watchdog: if Claude emits no output for longer than N seconds, it is
# considered hung and killed. Be generous: subagents run inside the same process
# and stay silent for minutes. 0 disables it. Default: 900
CLAUDE_STALL_TIMEOUT=900

# WARNING: with this default Claude runs WITHOUT permission prompts and executes
# whatever a Telegram message makes it do, with the rights of the bot's system
# user and its `gh` token. Run the bot as a dedicated unprivileged user, give `gh`
# a narrowly scoped token (see "Security" in README.md), or set a stricter value,
# e.g. CLAUDE_EXTRA_ARGS=--permission-mode,acceptEdits
# Extra claude arguments, comma-separated. Default: --dangerously-skip-permissions
CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions

# Models selectable with /model, comma-separated; values go to `claude --model` as they are.
# A `--model` in CLAUDE_EXTRA_ARGS pins the model and disables /model.
# Default: fable,opus[1m],opus,sonnet,haiku
# CLAUDE_MODELS=fable,opus[1m],opus,sonnet,haiku

# Model of each kind of epic run, passed to `claude --model` for that run. Empty = fall back to
# the model for all topics (see /model); all three empty = the model for all topics only. A
# non-empty value must be in CLAUDE_MODELS, otherwise the bot fails at startup. A `--model` in
# CLAUDE_EXTRA_ARGS overrides them all. Built-in agents with `model: inherit` run on the epic
# run's model, unless CLAUDE_CODE_SUBAGENT_MODEL_FORCE is set. `opus` and `opus[1m]` are
# different context windows. Default: empty
# MODEL_EPIC_TICK=sonnet
# MODEL_EPIC_FINAL=opus
# MODEL_EPIC_REVIEW=opus[1m]

# OpenCode instance (ENGINE=opencode) only. With ENGINE=claude these keys are ignored.
# The installer checks OPENCODE_BIN instead of CLAUDE_BIN, and MODEL_EPIC_* and CLAUDE_MODELS do
# not apply: the model of every run is the one below. The timeouts above do apply.

# Path or name of the opencode binary. Default: opencode
# OPENCODE_BIN=opencode

# Model of every run as provider/model (or provider/model#variant). Empty = the default model of
# your OpenCode configuration. Changing it starts a new session (like changing ENGINE).
# Default: empty
# OPENCODE_MODEL=anthropic/claude-sonnet-5.5

# Extra opencode arguments, comma-separated. The bot passes them after its own
# (--format json --standalone --auto), so do not repeat those. Default: empty
# OPENCODE_EXTRA_ARGS=--title,workspace-assistant

# Kimi Code instance (ENGINE=kimi) only. With ENGINE=claude or ENGINE=opencode these keys are
# ignored. The installer checks KIMI_BIN instead of CLAUDE_BIN, and CLAUDE_MODELS, CLAUDE_EXTRA_ARGS
# and MODEL_EPIC_* do not apply: the model of every run is the one below. The timeouts above do
# apply. The installer also warns that a Kimi run is approved automatically.

# Path of the kimi binary. Use an ABSOLUTE path: the engine installs itself into ~/.kimi-code/bin,
# which the PATH of a service does not have. Default: kimi (resolved against PATH)
# KIMI_BIN=/home/you/.kimi-code/bin/kimi

# Home of the logged-in Kimi CLI. Empty = the default home of the engine (~/.kimi-code). The bot
# never copies the credentials: every run home links to this one, so the rotated refresh token stays
# valid. A single consumer is assumed: another Kimi client on the same home shares those credentials
# and may refresh the token concurrently. Default: empty
# KIMI_HOME=/home/you/.kimi-code

# Model of every run, named as the alias your Kimi config.toml defines (passed as -m). Empty = the
# default_model of that file. Changing it starts a new session (like changing ENGINE). Default: empty
# KIMI_MODEL=kimi-for-coding

# Extra kimi arguments, comma-separated. The bot passes them after its own
# (-p <prompt> --output-format stream-json), so do not repeat those. Default: empty
# KIMI_EXTRA_ARGS=--verbose

# Memory of the instance (optional, OpenCode and Kimi). Those engines read no user scope, so a run
# gets no memory the way a Claude Code run does from its hooks and ~/.claude/CLAUDE.md. Set an
# ABSOLUTE path of the memory-3layer client and the bot fills that gap: `memory-3layer context` names
# the memory files (L0, the project's SESSION.md and project.md), the bot reads them itself and puts
# their content into the system prompt of an OpenCode run and of a new Kimi session — a resumed Kimi
# session keeps the snapshot it was created with — so the run needs no access to those paths. It also
# pulls the memory before a run (for the next one) and pushes it after a run, in
# the background, at most one sync at a time (state/memory-3layer.lock); a client that is missing,
# fails or hangs never delays or fails a run, it only leaves a line in the log. With ENGINE=claude the
# setting changes nothing. Default: empty (off)
# MEMORY_3LAYER_BIN=/home/you/.local/bin/memory-3layer

# Ceiling of the injected part of ONE memory file, bytes: above it only the NEWEST part of the file is
# injected. A SESSION.md of a long-lived project can be hundreds of KB. 0 turns the injection off.
# Default: 32768
# MEMORY_3LAYER_CONTEXT_MAX_BYTES=32768

# Anthropic-compatible provider (optional). With ANTHROPIC_BASE_URL empty, or with a host
# api.anthropic.com / *.anthropic.com, the bot talks to Anthropic; any other host switches on
# foreign-provider limit handling (a 429 / "rate limit" pauses the queue for an hour, while a
# quota / balance / insufficient error is reported in the chat without a pause).
# Every key in this .env whose name starts with ANTHROPIC_ or CLAUDE_CODE_ is passed straight
# into the environment of every claude process; the real process environment wins over this file.
#
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
#   ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
#   ANTHROPIC_MODEL=anthropic/claude-sonnet-5.5
#   CLAUDE_CODE_SUBAGENT_MODEL=anthropic/claude-haiku-4-5
#
# ANTHROPIC_AUTH_TOKEN replaces the subscription: with it set, claude authenticates with this
# token against ANTHROPIC_BASE_URL instead of your Claude Code / API account. It is masked in the
# bot's outgoing Telegram messages like any other *TOKEN* value.
# ANTHROPIC_MODEL is the model recorded in the engine fingerprint of a stored session on a foreign
# provider when a run has no `--model`; built-in agents with `model: inherit` carry the inherited
# model through the same way, and a `--model` in CLAUDE_EXTRA_ARGS pins it. Default: empty
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
# ANTHROPIC_MODEL=anthropic/claude-sonnet-5.5

# Files whose values are all masked ([REDACTED]) in what the bot sends to Telegram: comma-separated,
# `~` is expanded, dotenv format (an `export ` prefix is allowed). Listing a file is the statement that
# its values are secret. Values of this .env and of the process environment whose key contains
# TOKEN/SECRET/PASSWORD/PASSWD/CREDENTIAL or ends with _KEY/_PAT are masked without this setting.
# SECRET_ENV_FILES=~/.config/app/secrets.env

# Commit gate (AUTO_COMMIT=1): the bot blocks its own commit and push when the staged diff or an
# unpushed commit contains a secret. Comma-separated path globs (relative to the repository root, `*`
# also matches `/`) where the SHAPE patterns do not fire, for fixtures. Known values (see above) are
# always checked, a path cannot be excluded from them. Default: empty
# SECRET_SCAN_EXCLUDE=tests/fixtures/*,docs/examples/*

# Text appended to the system prompt of `claude -p` (not split on commas; the value is
# taken as a whole). Use it to tell Claude about the run context. Default: empty
# CLAUDE_APPEND_SYSTEM_PROMPT=You are running as a Telegram bot assistant...

# Persona files (common.md, arch.md, review.md, pm.md, epic.md) in this directory,
# relative to REPO_PATH, replace the persona text shipped in prompts/*.md.dist; the contract
# texts are overridden only by a local prompts/<name>.md (and always reported in the reply).
# Re-read on every run. A missing file falls back to prompts/<name>.md or its .dist with
# a warning in the reply. See PROMPTS.md. Default: empty (only the texts from prompts/ are used)
# PROMPTS_DIR=context/prompts

# Bot state directory (SQLite database, outbox, inbox, epic signals).
# Default: ./state next to the code. A relative path is taken from the installation directory
# (not from the current directory), the same for the bot and for bin/ctl.sh.
# STATE_DIR=/var/lib/workspace-assistant

# A run that ends with an engine error leaves the tail of its event stream (last 256 KiB) and
# stderr (last 16 KiB), masked, in STATE_DIR/failed-runs (files 0600, directory 0700) and
# writes the reason to the log.
# Evidence older than this many days is pruned; 0 disables the age limit. Independently of the
# age, only the newest 20 failed runs are kept. Default: 14
# FAILED_RUN_EVIDENCE_DAYS=14

# Long-polling timeout while idle, seconds. Default: 30
POLL_TIMEOUT=30

# Timeout of network git operations (pull/push), seconds: protects against hanging
# forever when git waits for an SSH passphrase/host key or a dead network. Default: 120
GIT_TIMEOUT=120

# Directory inside REPO_PATH whose subdirectories are separate git clones; the bot
# pulls them before a run and links their new commits in the reply.
# Default: empty (sub-repository handling is disabled)
# SUBREPOS_DIR=subrepos

# Timezone for logs and dates (PHP identifier). Default: UTC
# TIMEZONE=Europe/London

# Language of bot texts and command descriptions: a file code from
# resources/locales/ (de, en, es, fr, hi, ja, kk, ko, pt, ru, uk, uz, zh) or from
# LOCALES_DIR. Default: en
# BOT_LOCALE=en

# Directory inside REPO_PATH with extra/overriding locale files (<code>.json).
# Default: empty
# LOCALES_DIR=locales

# Epic plans directory inside REPO_PATH: <dir>/<slug>.md (plan) and
# <dir>/<slug>.journal.md (journal). Default: .workspace-assistant/epics
# EPICS_DIR=.workspace-assistant/epics

# Orchestrator: interval of the timer tick, minutes. Default: 30
# EPIC_TICK_MINUTES=30

# Stall: this many timer ticks in a row without GitHub changes and without
# openronin:in-progress move the epic to blocked. Default: 6
# EPIC_STALL_TICKS=6

# PR "quiet" period, minutes: no new commits or comments for this long before the
# hot review. Default: 10
# EPIC_QUIET_MINUTES=10

# How often the epic poll runs, in SECONDS, counted from the end of the previous pass.
# Minimum 10 (lower values are raised to 10). Default: 30
# EPIC_POLL_SECONDS=30

# Timeout of openronin:awaiting-answer counted from the last comment carrying the
# epic marker, minutes. Default: 120
# EPIC_ANSWER_TIMEOUT_MINUTES=120

# How many hours a confirmed red default branch is tolerated before the epic
# moves to blocked. Default: 6
# EPIC_MASTER_RED_HOURS=6

# Whether the bot commits and pushes in the managed repository. 1 (default): a run needs a clean
# working tree, the bot pulls before it and commits and pushes after it. 0: the bot does not touch git
# in the managed repository (no pull, commit, push or commit/discard buttons); the changes stay in the
# working tree for you to commit. Sub-repositories under SUBREPOS_DIR are still pulled.
# Epic runs start on a dirty tree too; their prompt tells Claude to write the journal to disk without
# committing or pushing, and the bot commits and pushes nothing after them. /compact does not stop on a
# dirty tree, only on edits made during its summarize phase.
# Changing this needs a bot restart.
# AUTO_COMMIT=1
