# Copy to .env and fill in. .env is in .gitignore, so tokens never reach the repository.
# Real environment variables (export) override the values from this file.
# Lists are comma-separated.

# Bot token from @BotFather (required)
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Whitelist of Telegram user ids (required; your own id: @userinfobot)
ALLOWED_USER_IDS=123456789

# Absolute path to the git repository (workspace) the bot manages (required)
REPO_PATH=/path/to/your/repo

# GitHub repository of the workspace as owner/name, used for commit links.
# Default: empty
# GITHUB_REPO=owner/repo

# GitHub owners (users/orgs) whose repositories the bot works with, comma-separated.
# The first one is the default owner: the short task form `repo#N` means `<first>/repo#N`.
# Epic tasks are `owner/repo#N` or `repo#N`; releases[].repo is `owner/repo` or `repo`.
# Required for epics and for PR links in the manual `review` mode. Default: empty
# GITHUB_OWNERS=owner

# GitHub logins allowed to author the `<!-- openronin:bot -->` marker, comma-separated,
# case-insensitive. When unset, the marker is accepted from any author and the bot logs
# a warning at startup. Default: empty
# OPENRONIN_LOGINS=your-bot-login

# Path or name of the claude binary. Default: claude
CLAUDE_BIN=claude

# Overall limit for one Claude call, seconds. 0 disables it (the stall timeout
# below remains the safety net against a "forever" process). Default: 0
CLAUDE_TIMEOUT=0

# Activity watchdog: if Claude emits no output for longer than N seconds, it is
# considered hung and killed. Be generous: subagents run inside the same process
# and stay silent for minutes. 0 disables it. Default: 900
CLAUDE_STALL_TIMEOUT=900

# WARNING: with this default Claude runs WITHOUT permission prompts and executes
# whatever a Telegram message makes it do, with the rights of the bot's system
# user and its `gh` token. Run the bot as a dedicated unprivileged user, give `gh`
# a narrowly scoped token (see "Security" in README.md), or set a stricter value,
# e.g. CLAUDE_EXTRA_ARGS=--permission-mode,acceptEdits
# Extra claude arguments, comma-separated. Default: --dangerously-skip-permissions
CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions

# Text appended to the system prompt of `claude -p` (not split on commas; the value is
# taken as a whole). Use it to tell Claude about the run context. Default: empty
# CLAUDE_APPEND_SYSTEM_PROMPT=You are running as a Telegram bot assistant...

# Persona files (common.md, arch.md, review.md, pm.md, epic.md) in this directory,
# relative to REPO_PATH, replace the persona text shipped in prompts/*.md.dist; the contract
# texts are overridden only by a local prompts/<name>.md (and always reported in the reply).
# Re-read on every run. A missing file falls back to prompts/<name>.md or its .dist with
# a warning in the reply. See PROMPTS.md. Default: empty (only the texts from prompts/ are used)
# PROMPTS_DIR=context/prompts

# Bot state directory (SQLite database, outbox, inbox, epic signals).
# Default: ./state next to the code. A relative path is taken from the installation directory
# (not from the current directory), the same for the bot and for bin/ctl.sh.
# STATE_DIR=/var/lib/workspace-assistant

# Long-polling timeout while idle, seconds. Default: 30
POLL_TIMEOUT=30

# Timeout of network git operations (pull/push), seconds: protects against hanging
# forever when git waits for an SSH passphrase/host key or a dead network. Default: 120
GIT_TIMEOUT=120

# Directory inside REPO_PATH whose subdirectories are separate git clones; the bot
# pulls them before a run and links their new commits in the reply.
# Default: empty (sub-repository handling is disabled)
# SUBREPOS_DIR=subrepos

# Timezone for logs and dates (PHP identifier). Default: UTC
# TIMEZONE=Europe/London

# Language of bot texts and command descriptions: a file code from
# resources/locales/ (de, en, es, fr, hi, ja, kk, ko, pt, ru, uk, uz, zh) or from
# LOCALES_DIR. Default: en
# BOT_LOCALE=en

# Directory inside REPO_PATH with extra/overriding locale files (<code>.json).
# Default: empty
# LOCALES_DIR=locales

# Epic plans directory inside REPO_PATH: <dir>/<slug>.md (plan) and
# <dir>/<slug>.journal.md (journal). Default: .workspace-assistant/epics
# EPICS_DIR=.workspace-assistant/epics

# Orchestrator: interval of the timer tick, minutes. Default: 30
# EPIC_TICK_MINUTES=30

# Stall: this many timer ticks in a row without GitHub changes and without
# openronin:in-progress move the epic to blocked. Default: 6
# EPIC_STALL_TICKS=6

# PR "quiet" period, minutes: no new commits or comments for this long before the
# hot review. Default: 10
# EPIC_QUIET_MINUTES=10

# How often the epic poll runs, in SECONDS, counted from the end of the previous pass.
# Minimum 10 (lower values are raised to 10). Default: 30
# EPIC_POLL_SECONDS=30

# Timeout of openronin:awaiting-answer counted from the last comment carrying the
# epic marker, minutes. Default: 120
# EPIC_ANSWER_TIMEOUT_MINUTES=120

# How many hours a confirmed red default branch is tolerated before the epic
# moves to blocked. Default: 6
# EPIC_MASTER_RED_HOURS=6

# Whether the bot commits and pushes in the managed repository. 1 (default): a run needs a clean
# working tree, the bot pulls before it and commits and pushes after it. 0: the bot does not touch git
# in the managed repository (no pull, commit, push or commit/discard buttons); the changes stay in the
# working tree for you to commit. Sub-repositories under SUBREPOS_DIR are still pulled.
# Epic runs still need a clean tree and still commit and push, so they wait while the tree is dirty.
# Changing this needs a bot restart.
# AUTO_COMMIT=1
