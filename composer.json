{
    "name": "gpslab/workspace-assistant",
    "description": "Telegram bot that runs Claude Code CLI against a git-based knowledge base (workspace) and commits the result",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "GpsLab\\WorkspaceAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GpsLab\\WorkspaceAssistant\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --only-summary-for-coverage-text --coverage-clover=coverage.xml"
    },
    "config": {
        "sort-packages": true
    }
}
